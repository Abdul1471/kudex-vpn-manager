#!/usr/bin/env bash
set -Eeuo pipefail
APP="/opt/kudex-vpn-manager/lib/kudex.py"
if [[ ! -f "$APP" ]]; then HERE="$(cd -- "$(dirname -- "$0")/.." && pwd)"; APP="$HERE/lib/kudex.py"; fi
[[ -f "$APP" ]] || { echo "Kudex application not found. Re-run install.sh." >&2; exit 1; }
exec python3 "$APP" "$@"
